// NovaOS Plymouth boot splash (script plugin)

Window.SetBackgroundTopColor(0.03, 0.04, 0.09);
Window.SetBackgroundBottomColor(0.01, 0.01, 0.03);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();
cx = screen_width / 2;
cy = screen_height / 2;

// ---------- logo (scaled to 260x260) ----------
logo.image  = Image("logo.png").Scale(260, 260);
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - 130, cy - 220, 10);

// ---------- wordmark ----------
word.image  = Image("wordmark.png");
word.sprite = Sprite(word.image);
word.sprite.SetPosition(cx - word.image.GetWidth() / 2, cy + 90, 10);

// ---------- spinner dots ----------
dot_image  = Image("dot.png");
dot_count  = 8;
dot_radius = 40;
ring_cy    = cy + 290;

for (i = 0; i < dot_count; i++)
{
  angle = i * 2 * 3.14159265 / dot_count;
  dots[i].sprite = Sprite(dot_image);
  dots[i].sprite.SetPosition(cx + Math.Sin(angle) * dot_radius - dot_image.GetWidth() / 2,
                             ring_cy + Math.Cos(angle) * dot_radius - dot_image.GetHeight() / 2,
                             10);
  dots[i].sprite.SetOpacity(0.25);
}

// ---------- progress bar ----------
bar_w = 320;
bar_h = 4;
bar_x = cx - bar_w / 2;
bar_y = screen_height - 110;

track.sprite = Sprite(dot_image.Scale(bar_w, bar_h));
track.sprite.SetPosition(bar_x, bar_y, 9000);
track.sprite.SetOpacity(0.12);

bar.image  = Image("progress.png");
bar.sprite = Sprite(bar.image.Scale(1, bar_h));
bar.sprite.SetPosition(bar_x, bar_y, 9001);

fun progress_callback(duration, progress)
{
  w = Math.Int(bar_w * progress);
  if (w < 1) w = 1;
  bar.sprite.SetImage(bar.image.Scale(w, bar_h));
}
Plymouth.SetBootProgressFunction(progress_callback);

// ---------- animation: gentle logo pulse + rotating spinner ----------
frame = 0;
active_index = 0;

fun refresh_callback()
{
  frame++;
  logo.sprite.SetOpacity(0.85 + 0.15 * Math.Sin(frame * 0.1));

  if (frame % 6 == 0)
  {
    for (i = 0; i < dot_count; i++)
      dots[i].sprite.SetOpacity(0.25);
    active_index = (active_index + 1) % dot_count;
    dots[active_index].sprite.SetOpacity(1.0);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---------- boot messages ----------
status.sprite = Sprite();
status.sprite.SetPosition(0, screen_height - 70, 10000);

fun message_callback(text)
{
  status.image = Image.Text(text, 0.75, 0.85, 1.0, 1.0, "Sans 11");
  status.sprite.SetImage(status.image);
  status.sprite.SetX(cx - status.image.GetWidth() / 2);
}
Plymouth.SetMessageFunction(message_callback);

// ---------- disk-encryption password prompt (kept simple) ----------
prompt.sprite = Sprite();
prompt.sprite.SetPosition(0, cy + 20, 10001);

fun display_password_callback(prompt_text, bullets)
{
  local.string = "";
  for (i = 0; i < bullets; i++) local.string += "*";
  prompt.image = Image.Text(prompt_text + " " + local.string, 1, 1, 1);
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetX(cx - prompt.image.GetWidth() / 2);
  prompt.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun hide_password_callback()
{
  prompt.sprite.SetOpacity(0);
}
Plymouth.SetHidePasswordFunction(hide_password_callback);

// ---------- quit ----------
fun quit_callback()
{
  logo.sprite.SetOpacity(0);
  word.sprite.SetOpacity(0);
  status.sprite.SetOpacity(0);
  bar.sprite.SetOpacity(0);
  track.sprite.SetOpacity(0);
  for (i = 0; i < dot_count; i++) dots[i].sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
